# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit .env.local or any file containing real credentials.

# NODE_ENV (development | test | production) is set by Next.js for dev/build/start.
# Leave it unset here; it is validated at startup.

# Public base URL of the app.
APP_BASE_URL=http://localhost:3000

# postgres://user:password@host:5432/dbname   -> PostgreSQL (node-postgres)
# pglite://memory                             -> in-memory PGlite (data lost on restart)
# pglite://./.data/dev                        -> file-backed PGlite (no database server needed)
DATABASE_URL=pglite://./.data/dev

# fatal | error | warn | info | debug | trace | silent  (default: info)
LOG_LEVEL=info
