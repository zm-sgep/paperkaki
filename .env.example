# Copy to .env.local for local development:  cp .env.example .env.local
# Never commit .env.local or any file containing real credentials.

# NODE_ENV (development | test | production) is set by Next.js for dev/build/start.
# Leave it unset here; it is validated at startup.

# Public base URL of the app.
APP_BASE_URL=http://localhost:3000

# postgres://user:password@host:5432/dbname   -> PostgreSQL (node-postgres)
# pglite://memory                             -> in-memory PGlite (data lost on restart)
# pglite://./.data/dev                        -> file-backed PGlite (no database server needed)
DATABASE_URL=pglite://./.data/dev

# fatal | error | warn | info | debug | trace | silent  (default: info)
LOG_LEVEL=info

# Sign-in. Only the local development adapter exists so far (ADR-0010).
# It is refused when NODE_ENV=production, so it cannot be deployed to real families.
AUTH_PROVIDER=dev
# At least 32 characters. Signs session cookies. Generate one:  openssl rand -base64 48
AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional: comma-separated emails that get the admin role when they sign in with the dev adapter.
DEV_ADMIN_EMAILS=admin@example.test
# Only for automated browser tests and CI, which run `next build` and `next start` with the dev
# adapter. Never set this in a deployed environment.
# E2E_ALLOW_DEV_AUTH=true

# Private file storage (ADR-0005). Files live under this folder; it is git-ignored via /.data/.
STORAGE_LOCAL_DIR=./.data/storage
# At least 32 characters. Signs short-lived file links. Generate one:  openssl rand -base64 48
STORAGE_SIGNING_SECRET=replace-with-at-least-32-other-random-characters

# Reading school notices (ADR-0002, ADR-0011). Upload is offered only when this is not "disabled".
#   disabled  -> default; no model is called and no upload button is shown
#   fixture   -> recorded answers from tests/fixtures/ai (tests and browser tests only)
#   anthropic -> the Anthropic API; needs ANTHROPIC_API_KEY
AI_PROVIDER=disabled
# Required only when AI_PROVIDER=anthropic. Never commit a real key.
# ANTHROPIC_API_KEY=
# Optional: model that reads notices (default: claude-opus-5-5).
# AI_EXTRACTION_MODEL=
